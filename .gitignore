# 作者源码按 source-lock.json 单独获取，不误提交嵌套仓库或上游缓存。
/reproductions/*/code/

# 本地论文原文件默认不公开转载；版本说明和来源记录保留。
/reproductions/*/paper/*.pdf
/reproductions/*/paper/*.part
/reproductions/*/paper/*.download

# 运行产物和独立环境不入库，保留空目录说明。
/reproductions/*/runs/*
!/reproductions/*/runs/README.md
/reproductions/*/.venv*/
/reproductions/*/data/

# 本机内部设计、Python 缓存及认证配置不公开。
/docs/superpowers/
__pycache__/
*.py[cod]
.pytest_cache/
.env
.env.*

# 研究数据默认不公开；经用户批准只放行两份 OGE 原始 CSV 及来源清单。
/data/**
!/data/README.md
!/data/raw/
!/data/raw/oge/
!/data/raw/oge/v0.8.0/
!/data/raw/oge/v0.8.0/2023/
!/data/raw/oge/v0.8.0/2023/manifest.json
!/data/raw/oge/v0.8.0/2023/SHA256SUMS
!/data/raw/oge/v0.8.0/2023/power_sector_data/
!/data/raw/oge/v0.8.0/2023/power_sector_data/ERCO.csv
!/data/raw/oge/v0.8.0/2023/carbon_accounting/
!/data/raw/oge/v0.8.0/2023/carbon_accounting/ERCO.csv
